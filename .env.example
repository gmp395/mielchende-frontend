# URL base de la API del backend (sin barra final)
VITE_API_URL=http://localhost:8081/api

# Clave pública del sitio de Cloudflare Turnstile (captcha).
# Este valor es la clave de prueba de Cloudflare, válida solo en desarrollo:
# muestra el reto y siempre lo da por superado.
# En producción, sustituirla por la clave real del panel de Cloudflare
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA